<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2><%= categoryDetails.name %></h2>
    
    <h3>Associated Service Projects</h3>
    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No projects found for this category.</p>
    <% } %>
   <!--  <p><a href="/edit-category/<%= categoryDetails.category_id %>">Edit Category</a></p> -->


    <% if (user && user.role_name === 'admin') { %>
    <a href="/edit-category/<%= category.category_id %>">Edit Category</a>
<% } %>


</main>

<%- include('partials/footer') %>