<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    
    <h2><%= projectDetails.title %></h2>
    <p><strong>Description:</strong> <%= projectDetails.description %></p>
    <p><strong>Location:</strong> <%= projectDetails.location %></p>
    <p><strong>Date:</strong> <%= projectDetails.date %></p>
    
<h3>Categories</h3>
    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <!-- Acá está el cambio clave: category.name -->
                <li><%= category.name %></li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories found for this project.</p>
    <% } %>
    
<% if (user && user.role_name === 'admin') { %>
    <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
    <a href="/assign-categories/<%= project.project_id %>">Edit Project Categories</a>
<% } %>

    <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
    <p><a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a></p>
</main>
<%- include('partials/footer') %>