<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    
    <h2><%= organizationDetails.name %></h2>
    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
    
    <p><strong>Description:</strong> <%= organizationDetails.description %></p>

    <h3>Projects Hosted by this Organization</h3>
    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No projects found for this organization.</p>
    <% } %>
</main>

<%- include('partials/footer') %>