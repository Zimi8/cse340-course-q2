<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2><%= project.title %></h2>
    
    <p><strong>Date:</strong> <%= project.date %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Partner Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    
    <h3>Description</h3>
    <p><%= project.description %></p>

    <h3>Categories</h3>
    <% if (categories && categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories assigned to this project.</p>
    <% } %>
</main>

<%- include('partials/footer') %>