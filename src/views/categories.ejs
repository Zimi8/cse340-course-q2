<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    
    <% if (categories && categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>"><strong><%= category.name %></strong></a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories available right now.</p>
    <% } %>
  <p><a href="/new-category">Add a New Category</a></p> <!-- to avoid writning the rout in the browser or navigator-->
</main>

<%- include('partials/footer') %>