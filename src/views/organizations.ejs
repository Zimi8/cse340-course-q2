<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    
    <% if (organizations && organizations.length > 0) { %>
        <ul>
            <% organizations.forEach(org => { %>
                <li>
                    <a href="/organization/<%= org.organization_id %>"><strong><%= org.name %></strong></a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No organizations available right now. Check back later!</p>
    <% } %>
    <p><a href="/new-organization">Add a new organization</a></p>s
</main>

<%- include('partials/footer') %>